# Copy this file to .env. The real .env file is ignored by Git.
# Never put real credentials in this example file or in source code.
#
# Trantor reads environment variables from the process environment.
# There is no application entry point yet, so there is no automatic .env
# loader; export these values in your shell, IDE, or future launcher.

# Machine-specific configuration
TRANTOR_SETTINGS_PATH=config/settings.json
TRANTOR_LOG_LEVEL=INFO

# Reserved for later phases. Current phases do not read or use these values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# NinjaTrader integration is not implemented. No endpoint, credential, account,
# sandbox, permission, or order-routing values are assumed or configured here.
